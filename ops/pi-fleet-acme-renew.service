[Unit]
Description=Renew Pi Fleet public TLS certificate
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/letsencrypt/renewal/pi.homevlad.ru.conf
[Service]
Type=oneshot
ExecStart=/opt/pi-fleet-acme/bin/certbot renew --quiet --deploy-hook /opt/pi-reinstall/ops/deploy-letsencrypt.sh
TimeoutStartSec=15min
UMask=0077
