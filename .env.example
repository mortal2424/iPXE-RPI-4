# Documentation addresses. Replace with your own before starting Compose.
FLEET_IP=192.0.2.10
FLEET_NETWORK=192.0.2.0/24
# Optional comma-separated subnets for SSH monitoring and management.
FLEET_MANAGEMENT_NETWORKS=
FLEET_TEST_PI=192.0.2.20
FLEET_STATE=/srv/pi-reinstall/state
FLEET_BOOT_FILES=/srv/pi-reinstall

# Optional public domain; uses DNS-01 with a private A record / split DNS.
# FLEET_DOMAIN=fleet.example.com
